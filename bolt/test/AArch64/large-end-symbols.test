; Test that large address end symbols work correctly
; Verify BOLT handles sections >128MB with end symbols

REQUIRES: system-linux
REQUIRES: aarch64-registered-target

RUN: llvm-mc -filetype=obj -triple aarch64-unknown-linux-gnu %S/Inputs/large-end-symbols.s -o %t.o
RUN: %clang %cflags -no-pie %t.o -o %t.exe -nostdlib -Wl,-q

RUN: llvm-bolt %t.exe -o %t.bolt --debug-only=bolt 2>&1 | FileCheck %s

CHECK-DAG: BOLT-INFO: etext is in the end of .text