; Test that constant islands work with end symbols
; Verify BOLT detects and processes end symbols correctly

REQUIRES: system-linux
REQUIRES: aarch64-registered-target

RUN: llvm-mc -filetype=obj -triple aarch64-unknown-linux-gnu %S/Inputs/constant-island-endsymbols.s -o %t.o
RUN: %clang %cflags -fPIC -pie %t.o -o %t.exe -nostdlib -Wl,-q -Wl,-z,notext

RUN: llvm-bolt %t.exe -o %t.bolt --debug-only=bolt 2>&1 | FileCheck %s

CHECK-DAG: BOLT-INFO: etext is in the end of .text
CHECK-DAG: BOLT-INFO: _edata is in the end of .data