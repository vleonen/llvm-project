# Test: stp w0, w1, [sp, #-0x10]!
# Expected V=16 (the W-pair immediate is scaled by 4, not 8; without the
# fix the pass reported V=32)
# REQUIRES: system-linux
# REQUIRES: aarch64-registered-target
#
# RUN: llvm-mc -filetype=obj -triple aarch64-unknown-linux-gnu %S/Inputs/stack-instr-stpw-pre.s -o %t.o
# RUN: %clang %cflags -nostdlib %t.o -o %t.exe
# RUN: llvm-bolt %t.exe -o %t.bolt --print-only=test_stpw_pre --stack-ops-test-pass | FileCheck %s
#
# CHECK: BOLT-INFO: StackOpsTestPass: V=16
