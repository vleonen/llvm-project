; Test that split functions work with end symbols
; Verify BOLT detects end symbols during function splitting

REQUIRES: system-linux
REQUIRES: aarch64-registered-target

RUN: llvm-mc -filetype=obj -triple aarch64-unknown-linux-gnu %S/Inputs/profile-end-symbols.s -o %t.o
RUN: %clang %cflags -no-pie %t.o -o %t.exe -nostdlib -Wl,-q

RUN: llvm-bolt %t.exe -o %t.bolt --split-functions --debug-only=bolt 2>&1 | FileCheck %s

CHECK-DAG: BOLT-INFO: etext is in the end of .text
CHECK-DAG: BOLT-INFO: foo_end is in the end of .text
CHECK-DAG: BOLT-INFO: bar_end is in the end of .text