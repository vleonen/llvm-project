## This test verifies that JITLink's EndSymbols resolution produces
## the correct debug output format and messages.

REQUIRES: system-linux
REQUIRES: aarch64-registered-target

RUN: llvm-mc -filetype=obj -triple aarch64-unknown-unknown \
RUN:   %S/Inputs/jitlink-debug.s -o %t.o
RUN: %clang %cflags -no-pie %t.o -o %t.exe -Wl,-q

// Run BOLT with debug output to capture JITLink EndSymbols resolution
RUN: llvm-bolt %t.exe -o %t.bolt --debug-only=bolt 2>&1 | FileCheck %s

// Verify EndSymbols are registered correctly
CHECK: BOLT-INFO: etext is in the end of .text

// Verify JITLink resolution messages (these come from JITLinkLinker.cpp)
// Note: These messages appear during the linking phase, not during
// symbol discovery, so they may not appear in all cases.

// When JITLink needs to resolve an end symbol during relocation processing:
