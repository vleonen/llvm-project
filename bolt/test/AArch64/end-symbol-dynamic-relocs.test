## Test that BOLT correctly handles end-of-section symbols with dynamic
## relocations on AArch64. This is a lit test wrapper for end-symbol-dynamic-relocs.s.

# REQUIRES: target=aarch64{{.*}}, asserts

RUN: llvm-mc -filetype=obj -triple aarch64-unknown-unknown %S/end-symbol-dynamic-relocs.s -o %t.o
RUN: ld.lld %t.o -o %t.exe -q --dynamic-linker=/lib/ld-linux-aarch64.so.1
RUN: llvm-bolt %t.exe -o %t.bolt --print-cfg --debug-only=bolt 2>&1 | FileCheck %S/end-symbol-dynamic-relocs.s

CHECK: considering symbol _end for function
CHECK: _end is in the end of .bss
CHECK-NOT: Binary Function "_end{{.*}}" after building cfg