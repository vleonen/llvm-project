## Test that BOLT correctly handles end-of-section symbols with relocations
## on AArch64. This is a lit test wrapper for end-symbol-relocations.s.

# REQUIRES: target=aarch64{{.*}}, asserts

RUN: llvm-mc -filetype=obj -triple aarch64-unknown-unknown %S/end-symbol-relocations.s -o %t.o
RUN: ld.lld %t.o -o %t.exe -q
RUN: llvm-bolt %t.exe -o %t.bolt --print-cfg --debug-only=bolt 2>&1 | FileCheck %S/end-symbol-relocations.s

CHECK: considering symbol etext for function
CHECK: etext is in the end of .text
CHECK-NOT: Binary Function "etext{{.*}}" after building cfg