; Test that split functions work with end symbols
; Verify BOLT handles function splitting with end symbols present

REQUIRES: system-linux
REQUIRES: aarch64-registered-target

RUN: llvm-mc -filetype=obj -triple aarch64-unknown-linux-gnu %S/Inputs/split-function-end-symbols.s -o %t.o
RUN: %clang %cflags -fPIC -pie %t.o -o %t.exe -nostdlib -Wl,-q

RUN: llvm-bolt %t.exe -o %t.bolt --split-functions --split-all-cold --debug-only=bolt 2>&1 | FileCheck %s

CHECK-DAG: BOLT-INFO: etext is in the end of .text