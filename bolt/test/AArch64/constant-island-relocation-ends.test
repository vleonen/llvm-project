; Test that relocations work with end symbols
; Verify BOLT handles PC-relative relocations to end symbols

REQUIRES: system-linux
REQUIRES: aarch64-registered-target

RUN: llvm-mc -filetype=obj -triple aarch64-unknown-linux-gnu %S/Inputs/constant-island-relocation-ends.s -o %t.o
RUN: %clang %cflags -fPIC -pie %t.o -o %t.exe -nostdlib -Wl,-q -Wl,-z,notext

RUN: llvm-bolt %t.exe -o %t.bolt --debug-only=bolt 2>&1 | FileCheck %s

CHECK-DAG: BOLT-INFO: etext is in the end of .text